{
  "name": "resumepdf",
  "version": "1.0.0",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "start": "nodemon dist/index.js",
    "build": "tsc && pkg . --out-dir build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.13",
    "@types/mjml": "^4.7.4",
    "@types/node": "^16.11.7",
    "@types/pdfkit": "^0.13.6",
    "@types/react": "^17.0.34",
    "dotenv": "^10.0.0",
    "nodemon": "^2.0.15",
    "pdfkit": "^0.12.1",
    "ts-node": "^10.4.0",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "body-parser": "^1.19.1",
    "express": "^4.17.1",
    "mjml": "^4.9.3",
    "resend": "^0.1.2"
  },
  "pkg": {
    "scripts": "dist/index.js",
    "targets": [
      "node16-win-x64"
    ],
    "outputPath": "build",
    "assets": [
      "node_modules/resend/**/*",
      "node_modules/string-width/**/*",
      "node_modules/strip-ansi/**/*",
      "node_modules/wrap-ansi/**/*",
      "node_modules/brotli/**/*",
      "node_modules/ansi-regex/**/*",
      "node_modules/ansi-styles/**/*",
      "src/resend"
    ]
  }
}
